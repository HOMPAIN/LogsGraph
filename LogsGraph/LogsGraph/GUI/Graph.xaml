<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LogsGraph"
             xmlns:oxy="http://oxyplot.org/wpf" x:Class="LogsGraph.Graph"
             mc:Ignorable="d" Height="148"
            d:DesignWidth="800">
    <Grid Background="MediumSeaGreen">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- боковые кнопки -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="6" Columns="1" HorizontalAlignment="Left" Margin="5">
                <Button Content="^" Click="ClickHide" />
                <Button Content="Size +" Click="ClickSizeAdd"/>
                <Button Content="Size -" Click="ClickSizeSub"/>
                <Button Content="Graphycs" Click="ClickGraphSettings"/>
                <Button Content="Del" Click="ClickDell"/>
                <Button Content="Add" Click="ClickAdd"/>
            </UniformGrid>
            <Button x:Name="BHide" Visibility="Hidden" Content="Show" HorizontalAlignment="Left" Click="ClickShow"/>
        </Grid>
        
        <!-- график -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- график -->
            <oxy:PlotView Grid.Row="0" x:Name="Plot" Background="#FFDAC646" BorderThickness="1" BorderBrush="Black"/>
            <!-- легенда -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" >
                <Label Content="Namessadasd" Padding="0" Background="White"></Label>
            </StackPanel>
            <!-- окно настройки -->
            <GroupBox Grid.Row="0" x:Name="Settings" Grid.Column="1" Background="Beige" Header="Настройка графиков" Visibility="Visible">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- настройки области графика -->
                    <StackPanel Grid.Column="0">
                        <DockPanel LastChildFill="True">
                            <Label Content="Имя графика" Width="90"/>
                            <TextBox x:Name="TxtName" TextChanged="TxtName_TextChanged"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5" >
                            <Label Content="Легенда"  Width="90"/>
                            <ComboBox x:Name="CbLegendPosition" SelectedIndex="0">
                                <ComboBoxItem Content="Снизу" Tag="Bottom"/>
                                <ComboBoxItem Content="Сверху" Tag="Top"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <!-- список всех графиков -->
                    <ListBox Grid.Column="1"  x:Name="AllGraphs"></ListBox>
                    <!-- настройки отдельного графика -->
                    <StackPanel Grid.Column="2">
                        <Button x:Name="BtnAddGraph" Content="Добавить график >>" Click="BtnAddGraph_Click"></Button>
                        <Button x:Name="BtnRemoveGraph" Content="Удалить график" Click="BtnRemoveGraph_Click"></Button>
                        <DockPanel LastChildFill="True">
                            <Label Content="Цвет графика" Width="90"/>
                            <TextBox x:Name="TxtColor" TextChanged="TxtColor_TextChanged" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5" >
                            <Label Content="Тип графика"  Width="90"/>
                            <ComboBox x:Name="CbLineType" SelectionChanged="CbLineType_SelectionChanged">
                                <ComboBoxItem Content="Линия" />
                                <ComboBoxItem Content="Пунктир"/>
                                <ComboBoxItem Content="Точка"/>
                                <ComboBoxItem Content="Линия с точкой" />
                                <ComboBoxItem Content="Пунктир с точкой"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <!-- список графиков в данной области графиков -->
                    <ListBox x:Name="PlotGraphycs" Grid.Column="3" SelectionChanged="PlotGraphycs_SelectionChanged"  ></ListBox>
                </Grid>
            </GroupBox>
        </Grid>
        
    </Grid>
</UserControl>
