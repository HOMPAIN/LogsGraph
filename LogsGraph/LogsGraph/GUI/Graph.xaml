<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LogsGraph"
             xmlns:oxy="http://oxyplot.org/wpf" x:Class="LogsGraph.Graph"
             mc:Ignorable="d" Height="148"
            d:DesignWidth="800">
    <Grid Background="MediumSeaGreen">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- боковые кнопки -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <UniformGrid Grid.Column="0" Rows="6" Columns="1" HorizontalAlignment="Left" Margin="5">
                <Button Content="^" Click="ClickHide" />
                <Button Content="Size +" Click="ClickSizeAdd"/>
                <Button Content="Size -" Click="ClickSizeSub"/>
                <Button Content="Graphycs" Click="ClickGraphSettings"/>
                <Button Content="Del" Click="ClickDell"/>
                <Button Content="Add" Click="ClickAdd"/>
            </UniformGrid>
            <Button x:Name="BHide" Visibility="Hidden" Content="Show" HorizontalAlignment="Left" Click="ClickShow"/>
        </Grid>
        
        <!-- график -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <oxy:PlotView Grid.Row="0" x:Name="Plot" Background="#FFDAC646" BorderThickness="1" BorderBrush="Black"/>
            <!-- легенда -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" >
                <Label Content="Namessadasd" Padding="0" Background="White"></Label>
            </StackPanel>
            <GroupBox Grid.Row="0" x:Name="Settings" Grid.Column="1" Background="Beige" Header="Настройка графиков" Visibility="Visible">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel LastChildFill="True">
                            <Label Content="Имя графика" Width="90"/>
                            <TextBox x:Name="TxtName"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox Grid.Column="1" ></ListBox>
                    <StackPanel Grid.Column="2">
                        <Button Content="Добавить график >>"></Button>
                        <Button Content="Удалить график"></Button>
                    </StackPanel>
                    <ListBox Grid.Column="3"></ListBox>
                </Grid>
            </GroupBox>
        </Grid>
        
    </Grid>
</UserControl>
