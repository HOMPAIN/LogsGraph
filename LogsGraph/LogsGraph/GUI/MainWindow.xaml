<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogsGraph"
        xmlns:oxy="http://oxyplot.org/wpf" x:Class="LogsGraph.MainWindow"
        mc:Ignorable="d"
        Title="LogsGraph" Height="570" Width="800">
    <Grid>

        <!-- Вкладки -->
        <TabControl Margin="0,2,0,0">
            <TabItem Header="Импорт данных">
                <Grid >
                    <local:DataParser ></local:DataParser>
                </Grid>
            </TabItem>
            <TabItem Header="Графики">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34*"/>
                        <ColumnDefinition Width="363*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Контейнер для графиков -->
                    <local:GraphsList x:Name="Graphycs" Grid.ColumnSpan="2"></local:GraphsList>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Кнопки сохранения и загрузки проекта -->
        <Label x:Name="LabProjPath" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,270,0" Padding="2" >Путь к файлу проекта</Label>
        <Button x:Name="BtnProjLoad" Content="Загрузить проект" Width="120" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,130,0" Click="BtnProjLoad_Click"></Button>
        <Button x:Name="BtnProjSave" Content="Сохранить проект" Width="120" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0" Click="BtnProjSave_Click"></Button>
    </Grid>
</Window>
