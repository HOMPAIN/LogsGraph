<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogsGraph"
        xmlns:oxy="http://oxyplot.org/wpf" x:Class="LogsGraph.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="570" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Импорт данных">
                <Grid Background="#FFE5E5E5">
                    <local:DataParser ></local:DataParser>
                </Grid>
            </TabItem>
            <TabItem Header="Графики">
                <Grid Background="#FF00E5E5">
                    <!-- Контейнер для графиков -->
                    <local:GraphsList x:Name="Graphycs"></local:GraphsList>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Content="Загрузить проект" Width="120" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,130,0"></Button>
        <Button Content="Сохранить проект" Width="120" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,5,0"></Button>
    </Grid>
</Window>
