<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LogsGraph"
             xmlns:oxy="http://oxyplot.org/wpf" x:Class="LogsGraph.DataParser"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFAED5B8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="29" />
                <RowDefinition Height="250" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>
            <!-- строка с адресом файоа -->
            <Grid Grid.Row="0" Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ShowHelp" Background="#f7a48f"  Margin="0,0,10,0" Click="ShowHelp_Click">Подсказка ?</Button>
                <TextBox Grid.Column="1" x:Name="FilePath" TextWrapping="Wrap" Text="File Path"/>
                <Button Grid.Column="2" x:Name="FileSelect" Content="Выбрать файл" Click="FileSelect_Click"/>
            </Grid>
            <!-- Подсказка -->
            <Label x:Name="LHelp1"  Background="#D060f7dc" Visibility="Hidden" MouseLeftButtonUp="HideHelp" >
                <TextBlock FontSize="15" TextWrapping="Wrap">
                    1. Выбрать файл с данными
                </TextBlock>
            </Label>
            <!-- профиль загрузки -->
            <GroupBox Grid.Row="1" Header="Профили загрузки файлов">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- параметры выбранного профиля -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"  Margin="5">
                            <!-- Имя профиля -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Имя профиля" Width="150"/>
                                <TextBox x:Name="TxtName" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <!-- разделитель значений -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Разделитель" Width="150"/>
                                <TextBox x:Name="TxtSeparator" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <!-- число игнорированных слог в начале файла -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Игнорировать строк" Width="150"/>
                                <TextBox x:Name="TxtIgnoreRows" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                            </StackPanel>

                            <!-- Группа для общего столбца X -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Общий столбец X" Width="150"/>
                                <!-- Да = MultiX = false (один столбец), Нет = MultiX = true (разные) -->
                                <!-- Логика инвертирована в коде, если нужно наоборот -->
                                <RadioButton x:Name="RbXSingle" GroupName="XGroup" Content="Да" Margin="0,0,10,0" Checked="Radio_X_Changed"/>
                                <RadioButton x:Name="RbXMulti" GroupName="XGroup" Content="Нет" Checked="Radio_X_Changed"/>
                            </StackPanel>

                            <!-- формат времени -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Label Content="Формат даты" Width="150"/>
                                <TextBox x:Name="TxDateFormat" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="TextBlock"/>
                        </StackPanel>
                        <Label Grid.Row="1" x:Name="LoadStatus"  Content="Загрузка" Margin="0"></Label>
                    </Grid>
                    <!-- список профилей загрузки -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="SelectTemplate" Grid.Row="0" SelectionChanged="SelectTemplate_SelectionChanged"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="BtnAdd" Grid.Column="0" Content="Добавить" Click="BtnAdd_Click" Margin="0,0,1,1"/>
                            <Button x:Name="BtnRemove" Grid.Column="1" Content="Удалить" Click="BtnRemove_Click" Margin="1,0,0,1"/>
                            <Button x:Name="BtnTemplateSave" Grid.Row="1" Grid.Column="0" Content="Сохранить" Click="BtnAdd_Click" Margin="0,1,1,0"/>
                            <Button x:Name="BtnTemplateLoad" Grid.Row="1" Grid.Column="1" Content="Загрузить" Click="BtnRemove_Click" Margin="1,1,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>
            <!-- Подсказка -->
            <Label x:Name="LHelp2" Grid.Row="1"  Background="#D0c3f760" Visibility="Hidden" MouseLeftButtonUp="HideHelp">
                <TextBlock FontSize="15" TextWrapping="Wrap">
                    2. Описать структуру файла с данными для правильной загрузки и парсинга файла
                </TextBlock>
            </Label>
            <!-- предварительный просмотр -->
            <GroupBox Grid.Row="2" Header="Предварительный просмотр">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TB_FilePrev" Grid.Row="0" Margin="0,0,0,5" Text="Это первая строка.&#10;Это вторая строка.&#10;Это третья строка." />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <oxy:PlotView x:Name="PrevPlot" />
                        </Grid>
                        <ListBox x:Name="GraphsList" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="GraphsList_SelectionChanged"/>
                    </Grid>
                </Grid>
            </GroupBox>
            <!-- Подсказка -->
            <Label x:Name="LHelp3" Grid.Row="2"  Background="#D0f7be60" Visibility="Hidden"  MouseLeftButtonUp="HideHelp">
                <TextBlock FontSize="15" TextWrapping="Wrap">
                    3. Убедиться в том, что данные загружены правильно и выбрать нужные графики
                </TextBlock>
            </Label>
        </Grid>

        <!-- Список загруженных графиков -->
        <GroupBox Grid.Column="1"  Header="Графики проекта"   Background="#FFDF9090">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <oxy:PlotView x:Name="Prev2Plot" />
                <ListBox Grid.Row="1" x:Name="ProjGraphList" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ProjGraphList_Selected" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="AddGraph" Content="Добавить" Margin="0,0,2,0" Click="AddGraph_Click"/>
                    <Button Grid.Column="1" x:Name="RemoveGraph" Content="Удалить" Margin="2,0,0,0"/>
                </Grid>
            </Grid>
        </GroupBox>
        <!-- Подсказка -->
        <Label x:Name="LHelp4" Grid.Column="1"  Background="#D0c96d6d" MouseLeftButtonUp="HideHelp" Visibility="Hidden">
            <TextBlock FontSize="15" TextWrapping="Wrap">4. Добавить нужные графики в текущий проект</TextBlock>
        </Label>
    </Grid>
</UserControl>
