<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LogsGraph"
             xmlns:oxy="http://oxyplot.org/wpf" x:Class="LogsGraph.DataParser"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFAED5B8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="29" />
                <RowDefinition Height="7*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <!-- строка с адресом файоа -->
            <Grid Grid.Row="0" Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FilePath" TextWrapping="Wrap" Text="File Path"/>
                <Button Grid.Column="1" x:Name="FileSelect" Content="File Select" Click="FileSelect_Click"/>
            </Grid>
            <!-- профиль загрузки -->
            <GroupBox Grid.Row="1" Header="Профили загрузки файлов">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- параметры выбранного профиля -->
                    <StackPanel Grid.Column="0" Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Label Content="Имя профиля" Width="150"/>
                            <TextBox x:Name="TxtName" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Label Content="Разделитель" Width="150"/>
                            <TextBox x:Name="TxtSeparator" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Label Content="Игнорировать строк" Width="150"/>
                            <TextBox x:Name="TxtIgnoreRows" TextWrapping="Wrap" Width="129" TextChanged="Input_Changed"/>
                        </StackPanel>

                        <!-- Группа для плавающей точки -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Label Content="Плавающая точка" Width="150"/>
                            <RadioButton x:Name="RbPointComma" GroupName="PointGroup" Content=",    " Margin="0,0,10,0" Checked="Radio_Changed"/>
                            <RadioButton x:Name="RbPointDot" GroupName="PointGroup" Content="." Checked="Radio_Changed"/>
                        </StackPanel>

                        <!-- Группа для общего столбца X -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Label Content="Общий столбец X" Width="150"/>
                            <!-- Да = MultiX = false (один столбец), Нет = MultiX = true (разные) -->
                            <!-- Логика инвертирована в коде, если нужно наоборот -->
                            <RadioButton x:Name="RbXSingle" GroupName="XGroup" Content="Да" Margin="0,0,10,0" Checked="Radio_X_Changed"/>
                            <RadioButton x:Name="RbXMulti" GroupName="XGroup" Content="Нет" Checked="Radio_X_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- список профилей загрузки -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="SelectTemplate" Grid.Row="0" SelectionChanged="SelectTemplate_SelectionChanged"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAdd" Grid.Column="0" Content="Добавить" Click="BtnAdd_Click" Margin="0,0,2,0"/>
                            <Button x:Name="BtnRemove" Grid.Column="1" Content="Удалить" Click="BtnRemove_Click" Margin="2,0,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </GroupBox>
            <!-- предпросмотр графика -->
            <GroupBox Grid.Row="2" Header="Предпросмотр графиков">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <oxy:PlotView x:Name="PrevPlot" Grid.Column="0" />
                <ListBox x:Name="GraphsList" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="GraphsList_SelectionChanged"/>
            </Grid>
            </GroupBox>
        </Grid>

        <!-- Список загруженных файлов -->
        <GroupBox Grid.Column="1"  Header="Файлы проекта"   Background="#FFDF9090">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <ListBox x:Name="SelectFile" Grid.Row="0"   d:ItemsSource="{d:SampleData ItemCount=5}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="NewFIle" Content="Добавить" Margin="0,0,2,0"/>
                    <Button Grid.Column="1" x:Name="RemoveFIle" Content="Удалить" Margin="2,0,0,0"/>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
